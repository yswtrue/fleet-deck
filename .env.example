# FleetDeck local development topology.
#
# Copy to `.env` to customize; when `.env` is absent, `devenv.nix` falls back to
# this file. Every port/credential used by the local stack comes from here —
# `devenv.nix` derives FLEETDECK_DATABASE_URL / FLEETDECK_REDIS_URL /
# FLEETDECK_HUB_ADDR from these values. `docker compose` interpolates the same
# file for the deployment stack. Format: KEY=VALUE, no quotes, no spaces.

# Postgres (devenv service; DSN is derived as
# postgres://USER:PASSWORD@HOST:PORT/NAME?sslmode=disable)
FLEETDECK_DB_HOST=127.0.0.1
FLEETDECK_DB_NAME=fleetdeck
FLEETDECK_DB_USER=fleetdeck
FLEETDECK_DB_PASSWORD=fleetdeck
FLEETDECK_DB_PORT=55432

# Redis read-through cache (devenv service; URL is derived as
# redis://HOST:PORT/0)
FLEETDECK_REDIS_HOST=127.0.0.1
FLEETDECK_REDIS_PORT=56379

# Hub HTTP + WebSocket address (derived: FLEETDECK_HUB_ADDR=HOST:PORT)
FLEETDECK_HUB_HOST=127.0.0.1
FLEETDECK_HUB_PORT=7710

# vite dev server (web)
FLEETDECK_WEB_HOST=127.0.0.1
FLEETDECK_WEB_PORT=7711

# Public hostname served by the bundled Traefik ingress (`--profile traefik`).
# Unset/empty routes only `Host(localhost)`; set it for a real domain (the
# domain's DNS must point at this host). Behind an external Traefik, attach the
# hub to that proxy's network instead (docs/DEPLOYMENT.md).
FLEETDECK_PUBLIC_HOST=

# Optional: VAPID "sub" claim used by Web Push (mailto: address or https URL).
# Leave unset for the default mailto:admin@fleetdeck.local.
# FLEETDECK_VAPID_SUBJECT=mailto:ops@example.com

# Optional: automatic re-dispatches of a running task whose node process
# restarted (the task is re-run with its original prompt as a new session).
# Default 1; 0 disables the automatic retry.
# FLEETDECK_TASK_RETRY_LIMIT=1

# Optional: hub image used by `docker compose` (published release, e.g.
# ghcr.io/yswtrue/fleet-deck:v1.2.3). Leave unset to build from the source tree.
# FLEETDECK_HUB_IMAGE=ghcr.io/yswtrue/fleet-deck:latest
